VITE_NOVEL_BACKEND_URL=http://127.0.0.1:18181
NOVEL_DATA_DIR=./NovelGenerator
# Optional CORS origins for non-default frontend URLs. Supports JSON array or comma-separated list.
NOVEL_CORS_ORIGINS=

# OpenAI-compatible chat model credentials.
NOVEL_MODEL_API_KEY=
NOVEL_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# OpenAI-compatible embedding credentials. Built-in local embedding does not need a key.
NOVEL_EMBEDDING_API_KEY=
# Optional local embedding model directory override for diagnostics.
NOVEL_LOCAL_EMBEDDING_CACHE_DIR=

# Optional license device hints, comma-separated.
NOVEL_LICENSE_DEVICE_HINTS=
# Optional public key override for local license signing tests.
NOVEL_LICENSE_PUBLIC_KEY=

# 联网考据：阿里百炼会复用上面的 DASHSCOPE_API_KEY 或应用内保存的模型 Key。
BOCHA_API_KEY=
BOCHA_SEARCH_ENDPOINT=
